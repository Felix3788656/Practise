    )
    
    rx_rrt, ry_rrt = planner_rrt.planning(animation=False)
    
    draw_env(ax2, fx, fy, ox, oy, sx, sy, gx, gy, "RRT* (Max Iter: 2000)")
    if rx_rrt:
        ax2.plot(rx_rrt, ry_rrt, "-m", linewidth=2, zorder=4)

    plt.tight_layout()
